<idea-plugin>
    <id>com.ykb.review.plugin</id>
    <name>YKB Bitbucket AI Code Review</name>
    <vendor email="developer@yapikredi.com.tr" url="https://www.yapikredi.com.tr">Yapı Kredi</vendor>

    <description><![CDATA[
        <h2>Bitbucket AI Pull Request &amp; Local Code Reviewer</h2>
        <p>Bitbucket Server/Data Center PR'larını ve yerel değişiklikleri doğrudan IntelliJ IDEA içerisinde yapay zeka ile denetleyen kurumsal kod inceleme eklentisi.</p>
        <ul>
            <li><b>Reviewer PR listesi:</b> Üzerinizdeki tüm açık PR'ları tek sorguda çeker, URL ile tekil PR incelemesi yapar.</li>
            <li><b>Auto PR Review:</b> Belirlenen aralıklarla açık PR'ları arka planda inceler ve yorum gönderir (aynı commit tekrar incelenmez).</li>
            <li><b>Satır içi yorumlar:</b> Bulgular diff'teki doğru satıra inline yorum olarak gönderilir.</li>
            <li><b>Repo bazlı özel talimatlar</b> ve <b>çift katmanlı model yönlendirme</b> (hızlı / güçlü model).</li>
            <li><b>Yerel inceleme:</b> Commit öncesi staged / unstaged / untracked değişiklikleri inceler, bulguları editörde işaretler.</li>
            <li>Token ve API key IDE'nin güvenli deposunda (PasswordSafe) saklanır.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Uygulama geneli ayarlar -->
        <applicationService serviceImplementation="com.ykb.review.config.ReviewSettingsState"/>

        <!-- Settings → Tools → YKB AI Code Review -->
        <applicationConfigurable
                parentId="tools"
                instance="com.ykb.review.config.ReviewSettingsConfigurable"
                id="com.ykb.review.config.ReviewSettingsConfigurable"
                displayName="YKB AI Code Review"/>

        <toolWindow id="YKB AI Review"
                    anchor="right"
                    secondary="false"
                    factoryClass="com.ykb.review.ui.ReviewToolWindowFactory"
                    icon="AllIcons.Actions.Preview"/>

        <statusBarWidgetFactory id="YkbReviewStatusBarWidget"
                                implementation="com.ykb.review.ui.ReviewStatusBarWidgetFactory"/>

        <notificationGroup id="YKB AI Review Notifications"
                           displayType="BALLOON"
                           displayName="YKB AI Review"/>

        <!-- IDE açılışında Auto Review zamanlayıcısını başlatır -->
        <postStartupActivity implementation="com.ykb.review.startup.ReviewStartupActivity"/>
    </extensions>

    <actions>
        <action id="YKB.Review.ListPullRequests"
                class="com.ykb.review.actions.ListPullRequestsAction"
                text="Açık PR'ları Listele"
                description="Reviewer olduğunuz açık Bitbucket PR'larını listeler"
                icon="AllIcons.Actions.ListFiles"/>
        <action id="YKB.Review.ReviewUrl"
                class="com.ykb.review.actions.ReviewUrlAction"
                text="URL ile PR İncele…"
                description="Bitbucket PR URL'i girerek inceleme başlatır"/>
        <action id="YKB.Review.LocalReview"
                class="com.ykb.review.actions.LocalReviewAction"
                text="Yerel Değişiklikleri AI ile İncele"
                description="Commit öncesi yerel diff'i AI ile denetler"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="ChangesViewToolbar" anchor="last"/>
        </action>
        <action id="YKB.Review.ToggleAutoReview"
                class="com.ykb.review.actions.ToggleAutoReviewAction"
                text="Auto PR Review'u Aç / Kapat"
                description="Arka planda otomatik PR incelemesini açar veya kapatır"/>
        <action id="YKB.Review.RunAutoReviewNow"
                class="com.ykb.review.actions.RunAutoReviewNowAction"
                text="Auto PR Review'u Şimdi Çalıştır"
                description="Reviewer olduğunuz açık PR'ları hemen tarar"
                icon="AllIcons.Actions.Execute"/>
        <action id="YKB.Review.OpenSettings"
                class="com.ykb.review.actions.OpenSettingsAction"
                text="Ayarlar…"
                description="YKB AI Code Review ayarlarını açar"
                icon="AllIcons.General.Settings"/>
        <action id="YKB.Review.ClearCredentials"
                class="com.ykb.review.actions.ClearCredentialsAction"
                text="Kayıtlı Kimlik Bilgilerini Temizle"
                description="Saklanan Bitbucket token ve model API key'i siler"/>
        <action id="YKB.Review.ClearFindings"
                class="com.ykb.review.actions.ClearFindingsAction"
                text="Editör Bulgularını Temizle"
                description="Yerel incelemede editöre eklenen işaretleri kaldırır"/>

        <group id="YKB.Review.ActionGroup" text="YKB AI Review" popup="true" icon="AllIcons.Actions.Preview">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="Git.Menu" anchor="last"/>
            <reference ref="YKB.Review.ListPullRequests"/>
            <reference ref="YKB.Review.ReviewUrl"/>
            <reference ref="YKB.Review.LocalReview"/>
            <separator/>
            <reference ref="YKB.Review.ToggleAutoReview"/>
            <reference ref="YKB.Review.RunAutoReviewNow"/>
            <separator/>
            <reference ref="YKB.Review.OpenSettings"/>
            <reference ref="YKB.Review.ClearCredentials"/>
            <reference ref="YKB.Review.ClearFindings"/>
        </group>

        <!-- Status bar widget menüsü -->
        <group id="YKB.Review.AutoReviewMenu" popup="false">
            <reference ref="YKB.Review.ToggleAutoReview"/>
            <reference ref="YKB.Review.RunAutoReviewNow"/>
            <reference ref="YKB.Review.ListPullRequests"/>
            <reference ref="YKB.Review.OpenSettings"/>
        </group>
    </actions>
</idea-plugin>
